{
  "expo": {
    "name": "firtapplemon",
    "slug": "firtapplemon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "firtapplemon",
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "expo-build-properties",
        {}
      ],
      "expo-font",
      "expo-router"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/logo.png"
    }
  }
}
