{
  "expo": {
    "name": "firtapplemon",
    "slug": "firtapplemon",
    "version": "2.0.0",
    "jsEngine": "hermes",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "firtapplemon",
    "userInterfaceStyle": "automatic",
    "updates": {
      "enabled": false
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "extraPermissions": []
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow firtapplemon to access your photos",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-router"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.susa_09.firtapplemon",
      "permissions": ["INTERNET","READ_EXTERNAL_STORAGE"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/logo.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7781b800-666f-4696-818e-326bfb50c2a5"
      }
    }
  }
}